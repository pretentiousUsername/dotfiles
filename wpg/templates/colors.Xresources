! X colors.
! Generated by 'wal'
*foreground:        #ddbfae
*background:        #09030d
*.foreground:       #ddbfae
*.background:       #09030d
emacs*foreground:   #ddbfae
emacs*background:   #09030d
URxvt*foreground:   #ddbfae
XTerm*foreground:   #ddbfae
UXTerm*foreground:  #ddbfae
URxvt*background:   [100]#09030d
XTerm*background:   #09030d
UXTerm*background:  #09030d
URxvt*cursorColor:  #ddbfae
XTerm*cursorColor:  #ddbfae
UXTerm*cursorColor: #ddbfae
URxvt*borderColor:  [100]#09030d

