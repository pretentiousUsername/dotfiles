*.color6: #AFAFAF
*color6:  #AFAFAF
*.color7: #dedede
*color7:  #dedede
*.color8: #9b9b9b
*color8:  #9b9b9b
*.color9: #474747
*color9:  #474747
*.color10: #585858
*color10:  #585858
