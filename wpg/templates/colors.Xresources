! Black color that will not be affected by bold highlighting.
*.color66: #09030d
*color66:  #09030d

! Xclock colors.
XClock*foreground: #ddbfae
XClock*background: #09030d
XClock*majorColor:  rgba:dd/bf/ae/ff
XClock*minorColor:  rgba:dd/bf/ae/ff
XClock*hourColor:   rgba:dd/bf/ae/ff
XClock*minuteColor: rgba:dd/bf/ae/ff
XClock*secondColor: rgba:dd/bf/ae/ff

! Set depth to make transparency work.
! URxvt*depth: 32

