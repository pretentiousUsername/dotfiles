! X colors.
! Generated by 'wal'
*foreground:        #dbd6c9
*background:        #15150a
*.foreground:       #dbd6c9
*.background:       #15150a
emacs*foreground:   #dbd6c9
emacs*background:   #15150a
URxvt*foreground:   #dbd6c9
XTerm*foreground:   #dbd6c9
UXTerm*foreground:  #dbd6c9
URxvt*background:   [100]#15150a
XTerm*background:   #15150a
UXTerm*background:  #15150a
URxvt*cursorColor:  #dbd6c9
XTerm*cursorColor:  #dbd6c9
UXTerm*cursorColor: #dbd6c9
URxvt*borderColor:  [100]#15150a

! Colors 0-15.
*.color0: #15150a
*color0:  #15150a
*.color1: #987553
*color1:  #987553
*.color2: #CBAB3B
*color2:  #CBAB3B
*.color3: #AD8E67
*color3:  #AD8E67
*.color4: #CF9E63
*color4:  #CF9E63
*.color5: #508191
*color5:  #508191
*.color6: #CCAF94
*color6:  #CCAF94
*.color7: #dbd6c9
*color7:  #dbd6c9
*.color8: #99958c
*color8:  #99958c
*.color9: #987553
*color9:  #987553
*.color10: #CBAB3B
*color10:  #CBAB3B
*.color11: #AD8E67
*color11:  #AD8E67
*.color12: #CF9E63
*color12:  #CF9E63
*.color13: #508191
*color13:  #508191
*.color14: #CCAF94
*color14:  #CCAF94
*.color15: #dbd6c9
*color15:  #dbd6c9

! Black color that will not be affected by bold highlighting.
*.color66: #15150a
*color66:  #15150a

! Xclock colors.
XClock*foreground: #dbd6c9
XClock*background: #15150a
XClock*majorColor:  rgba:db/d6/c9/ff
XClock*minorColor:  rgba:db/d6/c9/ff
XClock*hourColor:   rgba:db/d6/c9/ff
XClock*minuteColor: rgba:db/d6/c9/ff
XClock*secondColor: rgba:db/d6/c9/ff

! Set depth to make transparency work.
! URxvt*depth: 32

