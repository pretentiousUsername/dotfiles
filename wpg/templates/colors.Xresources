! X colors.
! Generated by 'wal'
*foreground:        #c3c7c8
*background:        #102224
*.foreground:       #c3c7c8
*.background:       #102224
emacs*foreground:   #c3c7c8
emacs*background:   #102224
URxvt*foreground:   #c3c7c8
XTerm*foreground:   #c3c7c8
UXTerm*foreground:  #c3c7c8
