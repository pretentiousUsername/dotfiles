! X colors.
! Generated by 'wal'
*foreground:        #c1c1c3
*background:        #070710
*.foreground:       #c1c1c3
*.background:       #070710
emacs*foreground:   #c1c1c3
emacs*background:   #070710
URxvt*foreground:   #c1c1c3
XTerm*foreground:   #c1c1c3
UXTerm*foreground:  #c1c1c3
URxvt*background:   [100]#070710
XTerm*background:   #070710
UXTerm*background:  #070710
URxvt*cursorColor:  #c1c1c3
XTerm*cursorColor:  #c1c1c3
UXTerm*cursorColor: #c1c1c3
URxvt*borderColor:  [100]#070710

! Colors 0-15.
*.color0: #070710
*color0:  #070710
*.color1: #585FB1
*color1:  #585FB1
*.color2: #5573DE
*color2:  #5573DE
*.color3: #9172A0
*color3:  #9172A0
*.color4: #3D81F9
*color4:  #3D81F9
*.color5: #5A8AFB
*color5:  #5A8AFB
*.color6: #6998FE
*color6:  #6998FE
*.color7: #c1c1c3
*color7:  #c1c1c3
*.color8: #565669
*color8:  #565669
*.color9: #585FB1
*color9:  #585FB1
*.color10: #5573DE
*color10:  #5573DE
*.color11: #9172A0
*color11:  #9172A0
*.color12: #3D81F9
*color12:  #3D81F9
*.color13: #5A8AFB
*color13:  #5A8AFB
*.color14: #6998FE
*color14:  #6998FE
*.color15: #c1c1c3
*color15:  #c1c1c3

! Black color that will not be affected by bold highlighting.
*.color66: #070710
*color66:  #070710

! Xclock colors.
XClock*foreground: #c1c1c3
XClock*background: #070710
XClock*majorColor:  rgba:c1/c1/c3/ff
XClock*minorColor:  rgba:c1/c1/c3/ff
XClock*hourColor:   rgba:c1/c1/c3/ff
XClock*minuteColor: rgba:c1/c1/c3/ff
XClock*secondColor: rgba:c1/c1/c3/ff

! Set depth to make transparency work.
! URxvt*depth: 32

