! X colors.
! Generated by 'wal'
*foreground:        #dedede
*background:        #000000
*.foreground:       #dedede
*.background:       #000000
emacs*foreground:   #dedede
emacs*background:   #000000
URxvt*foreground:   #dedede
XTerm*foreground:   #dedede
UXTerm*foreground:  #dedede
URxvt*background:   [100]#000000
XTerm*background:   #000000
UXTerm*background:  #000000
URxvt*cursorColor:  #dedede
XTerm*cursorColor:  #dedede
UXTerm*cursorColor: #dedede
URxvt*borderColor:  [100]#000000

! Colors 0-15.
