! Xclock colors.
XClock*foreground: #c3c7c8
XClock*background: #102224
XClock*majorColor:  rgba:c3/c7/c8/ff
XClock*minorColor:  rgba:c3/c7/c8/ff
XClock*hourColor:   rgba:c3/c7/c8/ff
XClock*minuteColor: rgba:c3/c7/c8/ff
XClock*secondColor: rgba:c3/c7/c8/ff

! Set depth to make transparency work.
! URxvt*depth: 32

